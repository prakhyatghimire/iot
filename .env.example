# Copy to .env (git-ignored) or export these variables in your shell.
# NEVER commit real tokens, passwords or JWTs.

# ThingsBoard Cloud: MQTT/TLS uses 8883; REST uses HTTPS/443.
# TB_HOST is the MQTT endpoint. TB_REST_HOST defaults to TB_HOST when omitted.
TB_HOST=your-tenant.thingsboard.cloud
TB_REST_HOST=your-tenant.thingsboard.cloud
TB_HTTP_SCHEME=https
TB_HTTP_PORT=443
TB_MQTT_PORT=8883

# Single-node Phase 3 path (optional if using the fleet)
TB_DEVICE_TOKEN=REPLACE_WITH_SINGLE_DEVICE_TOKEN

# Three-node fleet: one DISTINCT Cloud device access token per device
TB_NODE_01_TOKEN=REPLACE_WITH_NODE_01_TOKEN
TB_NODE_02_TOKEN=REPLACE_WITH_NODE_02_TOKEN
TB_NODE_03_TOKEN=REPLACE_WITH_NODE_03_TOKEN

# Optional coordinate overrides (defaults are three Rasuwa water-source sites:
# Dhunche, Syafrubesi, Rasuwagadhi). Demonstration positions, not survey data.
# NODE_01_LAT=28.1100
# NODE_01_LON=85.2900
# NODE_02_LAT=28.0920
# NODE_02_LON=85.3610
# NODE_03_LAT=28.1710
# NODE_03_LON=85.3870

# Optional Cloud REST provisioning token. Cloud configuration may also be
# performed in the logged-in browser tab; never store a browser JWT in git.
# TB_REST_JWT=REPLACE_WITH_TENANT_REST_JWT

# Only needed for a self-hosted admin login when --provision is used without
# TB_REST_JWT. Do not invent or commit these for ThingsBoard Cloud.
# TB_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USER
# TB_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Leave unset to use the operating system trust store (recommended for Cloud).
# TB_CA_CERT=/path/to/ca.pem

# Approved defaults: 2 s minimum / 60 s maximum backoff. This Cloud tenant
# disconnects MQTT (rc=128, no QoS 1 PUBACK) when replay sends more than about
# ten data points in one message or when three nodes replay batches at once;
# use 1 so buffered rows drain one at a time and live telemetry/RPC stay up.
MQTT_RECONNECT_MIN_DELAY_S=2
MQTT_RECONNECT_MAX_DELAY_S=60
MQTT_REPLAY_BATCH_SIZE=1
MQTT_PUBLISH_TIMEOUT_S=30
