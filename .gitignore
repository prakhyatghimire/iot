# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets and local configuration (never commit)
.env
*.env
!.env.example
config.local.*
tokens.*

# SQLite databases and logs generated by the simulator
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
logs/
*.log
metrics/

# Demonstration and measurement evidence is intentionally versioned.
# Re-include it after the generic rules above.
!evidence/metrics/
!evidence/metrics/**
!evidence/*.log

# macOS
.DS_Store
